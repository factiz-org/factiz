---
// Een eigen factcheck van Factiz (PLAN #37.4, B82, DESIGN §4x), met de opbouw van een factcheck (PO 2026-11-19: "Onze eigen
// factchecks mogen ook de sidebar krijgen en meer in lijn komen met het pagina design van de andere checks ... alleen
// afwijken in design waar we duidelijk willen maken dat het een 'eigen' factcheck is"): het kruimelpad met terug, twee
// kolommen met de contextkaarten en de inhoud, de bewering en het antwoord op hun vlak, de koppen en de verbanden van een
// factcheck. Eigen blijven het zegel met de kop die zegt wat we vonden, het stempel van Factiz, het beeld met het stempel en
// de bronnen met hun nummer. Alleen in de taal van de check; een concept is nooit vindbaar en zegt dat het een concept is.
import Site from '../../../layouts/Site.astro';
import Kruimel from '../Kruimel.astro';
import Zegel from '../eigen/Zegel.astro';
import Stukken from '../eigen/Stukken.astro';
import Rij from '../Rij.jsx';
import ThemaTegel from '../ThemaTegel.jsx';
import LijnIcoon from '../LijnIcoon.jsx';
import ContextKaarten from '../ContextKaarten.astro';
import { haal } from '../../../lib/platform.js';
import { maakT } from '../../../lib/teksten.js';
import { BASIS, BCP47, pad } from '../../../lib/talen.js';
import Pijl from '../Pijl.astro';
const { taal, e } = Astro.props;
const t = maakT(taal);
// zoals de redactie in check.toml als nalezer staat (B84)
const REDACTIE = 'De redactie van Factiz';
// de kleur van het oordeel uit het archief (geen rood, geen stoplicht); de vorm draagt het onderscheid (D12)
const KLEUR = { onwaar: 'onwaar', misleidend: 'misleidend', context: 'deels-waar', grotendeels: 'deels-waar', klopt: 'waar', onbewezen: 'onbewezen' };
const kleur = KLEUR[e.oordeel] ?? 'onbewezen';
const meta = [t('eigen_vanaf', { datum: e.eerst_gezien }), e.posts_tekst, e.bereik].filter(Boolean).join(' · ');
const platte = (s) => s.map((d) => d.t ?? '').join('').replace(/\s+/g, ' ').trim();
// haar adres met jaar en maand (PLAN #37.11), in deze taal
const adres = BASIS + e.href;
const lijst = pad(taal, 'radar');
// haar pagina in het archief: de contextkaarten, het thema, de kenmerken, de dossiers en de namen, zoals bij elke
// factcheck; zonder die pagina (nog niet in deze uitgave) blijft de zijbalk bij de inhoud
const p = e.nummer ? await haal(`/api/${taal}/factcheck/${e.nummer}`) : null;
const eersteNaam = p?.namen?.[0];
const [metNaam, inThema] = await Promise.all([
  eersteNaam ? haal(`/api/${taal}/archief?naam=${eersteNaam.nummer}`) : null,
  p?.thema ? haal(`/api/${taal}/archief?thema=${p.thema.sleutel}`) : null,
]);
// drie andere factchecks per groep, zoals op een factcheck; de themagroep slaat over wat de naamgroep al toont
const anders = (g, zonder = new Set()) => (g?.rijen ?? []).filter((r) => r.nummer !== e.nummer && !zonder.has(r.nummer)).slice(0, 3);
const naamRijen = eersteNaam ? anders(metNaam) : [];
const themaRijen = anders(inThema, new Set(naamRijen.map((r) => r.nummer)));
const verbanden = (p?.dossiers?.length ?? 0) + naamRijen.length + themaRijen.length + (p?.namen?.length ?? 0) > 0;
// alleen een beeld dat er is (PO 2026-11-21: "Dingen waarvan we geen screenshot hebben of kunnen maken en die kaal erin
// staan mogen er ook uit"): een origineel of een beeld dat rondgaat zonder screenshot toont geen lege plek (B84); alleen
// een concept houdt de plek voor het beeld dat rondgaat, met *screenshot volgt*, als geheugensteun voor de redactie. Wat er
// was, staat ook bij de bronnen.
const beelden = e.beelden.filter((b) => b.pad || (e.concept && b.rol === 'rondgaat'));
const inhoud = [['bewering', t('bewering_kop')], ['wat-we-weten', t('eigen_weten')],
  e.niet_weten.length > 0 && ['niet-weten', t('eigen_niet_weten')],
  e.nog_uitzoeken.length > 0 && ['nog-uitzoeken', t('eigen_nog_uitzoeken')], e.tijdlijn.length > 0 && ['tijdlijn', t('eigen_tijdlijn')],
  ['bronnen', t('eigen_bronnen')], verbanden && ['verbanden', t('verbanden_kop')]].filter(Boolean);
// ClaimReview alleen bij een gepubliceerde check: dan is Factiz de redactie die oordeelt (B82)
const ld = e.concept ? '' : JSON.stringify({
  '@context': 'https://schema.org', '@type': 'ClaimReview', url: adres, inLanguage: BCP47[taal], claimReviewed: e.bewering,
  datePublished: e.gepubliceerd_iso, author: { '@type': 'Organization', name: 'Factiz', url: `${BASIS}/` },
  reviewRating: { '@type': 'Rating', alternateName: e.oordeel_tekst },
}).replaceAll('<', '\\u003c');
---
{/* zoekmachines zien het origineel en een vertaling die de redactie las (PLAN #37.11); een concept nooit */}
<Site titel={e.kop} hier="eigen" taal={taal} delen={['radar']} paden={e.paden} aangeboden={e.vindbaar_in} omschrijving={platte(e.kort)} soort="article" ld={ld}>
  <div class="baan pt-4">
    <div class="flex flex-wrap items-center justify-between gap-2 text-[12.5px] text-[var(--zacht)]">
      <Kruimel taal={taal} telefoon={false} stappen={[[t('eigen_titel'), lijst], e.maand.tekst && [e.maand.tekst, e.maand.href],
        p?.thema && [p.thema.naam, pad(taal, 'themes', p.thema.sleutel)]]} />
      <a id="terug" class="knop knop-stil" href={lijst} data-lijst={lijst}><Pijl terug /> {t('terug_resultaten')}</a>
    </div>

    <div class="mt-6 grid gap-10 max-md:mt-2 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <article class="min-w-0" lang={e.taal}>
        {/* de kop van een eigen check: het zegel, Factiz Radar met hoe het gemaakt is (PO 2026-11-19), en de kop die zegt wat we
            vonden (DESIGN §4x); wie precies schreef en nalas, staat onderaan */}
        {e.concept && <p class="fz-eigen-concept">{t('eigen_concept')}</p>}
        {/* een machinevertaling zegt dat ze er een is, met de link naar het origineel (PLAN #37.8, B85) */}
        {e.vertaling && <p class="fz-eigen-vertaling">{e.vertaling.tekst} <a class="link" href={e.vertaling.origineel}>{e.vertaling.link} <Pijl /></a></p>}
        <div class="fz-eigen-top">
          <Zegel id={`zegel-${e.sleutel}`} />
          <div><b>{t('eigen_titel')}</b>{[e.gepubliceerd, e.concept ? t('eigen_geschreven', { naam: e.auteur }) : t('eigen_ondertitel')].filter(Boolean).join(' · ')}</div>
        </div>
        <h1 class="fz-eigen-kop">{e.kop}</h1>

        <section id="bewering" class="grid gap-4">
          {/* de bewering en het antwoord op hun eigen zachte vlak, zoals bij een factcheck: een effen tint, nooit een veld (D11) */}
          <div class="podium grid gap-4">
            {(p?.thema || p?.kenmerken?.length > 0 || e.kenmerken) && (
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                {p?.thema && <span class="thema"><ThemaTegel thema={p.thema.sleutel} />{p.thema.naam}{p.land && <> · {p.land.naam}</>}</span>}
                {p?.kenmerken?.length > 0 ? p.kenmerken.map((k) => (
                  <a class="kenmerk-knop" href={k.href}><LijnIcoon wat={k.wat} waarde={k.waarde} /><span class="kenmerk-tekst">{k.naam}{k.regel && <> <span class="kenmerk-regel">{k.regel}</span></>}</span></a>
                )) : e.kenmerken && <span class="zacht text-[13px]">{e.kenmerken}</span>}
              </div>
            )}
            <div class="grid gap-1.5">
              <p class="text-[12.5px] font-medium text-[var(--zacht)]">{t('eigen_wat_rondgaat', { platform: e.platform })}</p>
              <blockquote data-nosnippet class="max-w-[var(--maat-kop)] font-[family-name:var(--serif)] text-[clamp(1.25rem,2.6vw,1.75rem)] leading-[1.3]">“{e.bewering}”</blockquote>
            </div>
            {/* het antwoord: hetzelfde stempel als bij een factcheck van een andere redactie, met Factiz en de zin die het
                draagt; het onderscheid met het archief is het zegel boven de kop, ook in grijstinten (D12) */}
            <section class="paneel vak" aria-labelledby="antwoord">
              <h2 id="antwoord" class="vakkop">{t('antwoord_kop')}</h2>
              <div class="uitspraak" data-soort={kleur}>
                <p class="uitspraak-label fz-stempelgroep"><span class="fz-stempel fz-stempel-groot" data-soort={kleur}>{e.oordeel_tekst}</span>
                  <span class="fz-stempel-wie">{t('stempel_volgens', { wie: 'Factiz' })}</span></p>
                <p class="fz-eigen-zin"><Stukken s={e.oordeel_zin} taal={taal} /></p>
              </div>
              {meta && <p class="zacht text-[13px]">{meta}</p>}
            </section>
          </div>
          <p class="fz-eigen-kort"><Stukken s={e.kort} taal={taal} /></p>
        </section>

        {beelden.length > 0 && (
          <div class="fz-eigen-beelden">
            {beelden.map((b) => b.rol === 'rondgaat' ? (
              <figure>
                {b.pad ? (
                  <img class="fz-eigen-foto" src={b.pad} width={b.breedte} height={b.hoogte} alt={b.alt} loading="lazy"
                       decoding="async" />
                ) : (
                  <div class="fz-eigen-plek" role="img" aria-label={b.alt}>
                    <span class="fz-eigen-wacht">{t('eigen_beeld_volgt')}</span>
                    {b.stempel && <span class="fz-eigen-afdruk">{b.stempel}</span>}
                  </div>
                )}
                <figcaption>{t('eigen_beeld_rondgaat')} {b.bijschrift}</figcaption>
              </figure>
            ) : (
              <figure>
                <a href={b.link || undefined}><img class="fz-eigen-foto" src={b.pad} width={b.breedte} height={b.hoogte} alt={b.alt}
                     loading="lazy" decoding="async" /></a>
                <figcaption>{t('eigen_beeld_origineel')}: {b.bijschrift}</figcaption>
              </figure>
            ))}
          </div>
        )}

        <section id="wat-we-weten" class="mt-10">
          <div class="sectiekop"><h2 class="leeskop">{t('eigen_weten')}</h2></div>
          <div class="fz-eigen-tekst">{e.tekst.map((a) => <p><Stukken s={a} taal={taal} /></p>)}</div>
          {e.rekensom.length > 0 && (
            <div class="fz-eigen-rol">
              <table class="fz-eigen-som">
                <caption>{t('eigen_rekensom')}</caption>
                <thead><tr><th scope="col">{t('eigen_geval')}</th><th scope="col">{t('eigen_som')}</th><th scope="col">{t('eigen_uitkomst')}</th></tr></thead>
                <tbody>{e.rekensom.map((r) => <tr><td>{r.geval}</td><td>{r.som}</td><td>{r.uitkomst}</td></tr>)}</tbody>
              </table>
            </div>
          )}
        </section>

        {e.niet_weten.length > 0 && (
          <section id="niet-weten" class="mt-10">
            <div class="sectiekop"><h2 class="leeskop">{t('eigen_niet_weten')}</h2></div>
            <div class="fz-eigen-tekst">{e.niet_weten.map((a) => <p><Stukken s={a} taal={taal} /></p>)}</div>
          </section>
        )}

        {/* wat nog uit te zoeken is, en de oproep om bij te dragen (B84, PO 2026-11-19: "misschien wel een oproep, draag bij
            aan deze factcheck, dat we het juist als een begin van een dialoog zien"); een mail, de site bewaart niets (B78) */}
        {e.nog_uitzoeken.length > 0 && (
          <section id="nog-uitzoeken" class="mt-10">
            {/* zonder aantal: de lijst staat in de smalle tekstkolom, en een getal rechts in de koprij hing daar los (PO
                2026-11-19: "this placement is a bit weird"); de punten staan er direct onder */}
            <div class="sectiekop"><h2 class="leeskop">{t('eigen_nog_uitzoeken')}</h2></div>
            <ul class="fz-eigen-uitzoeken">{e.nog_uitzoeken.map((n) => <li>{n}</li>)}</ul>
            <div class="paneel vak fz-eigen-bijdragen mt-4">
              <h3 class="kaartkop">{t('eigen_bijdragen_kop')}</h3>
              <p class="zacht max-w-[var(--maat-tekst)] text-[14px]">{t('eigen_bijdragen_tekst')}</p>
              <p class="flex flex-wrap items-center gap-x-3 gap-y-2"><a class="knop knop-primair" href={e.bijdragen.href}>{t('eigen_bijdragen_knop')}</a>
                <span class="mono select-all">{e.bijdragen.adres}</span></p>
            </div>
          </section>
        )}

        {e.tijdlijn.length > 0 && (
          <section id="tijdlijn" class="mt-10">
            <div class="sectiekop"><h2 class="leeskop">{t('eigen_tijdlijn')}</h2></div>
            <ol class="fz-eigen-tijd">{e.tijdlijn.map((r) => <li><span class="fz-eigen-wanneer">{r.datum}{r.tijd && <span class="fz-eigen-tijdstip">{r.tijd}</span>}</span><span>{r.wat}</span></li>)}</ol>
          </section>
        )}

        <section id="bronnen" class="mt-10">
          <div class="sectiekop"><h2 class="leeskop">{t('eigen_bronnen')}</h2><span class="mono">{e.bronnen.length}</span></div>
          <ol class="fz-eigen-bronnen">
            {e.bronnen.map((b) => (
              <li id={`bron-${b.nr}`}>
                <span class="fz-eigen-nr">{b.nr}</span>
                {/* de hele bron is de link (PO 2026-11-18: "het zou makkelijker zijn als de hele zin aan te klikken was"); een post
                    van een privépersoon zonder archiefkopie blijft tekst */}
                <span class="min-w-0">
                  {(b.url || b.archief) ? (
                    <a class="fz-eigen-bronlink" href={b.url || b.archief}>
                      <b>{b.uitgever}</b>, <span class="fz-eigen-brontitel">{b.titel}</span>{b.datum && `, ${b.datum}`}.{' '}
                      <span class="fz-eigen-host">{b.url ? b.host : t('eigen_archief')}</span>
                    </a>
                  ) : (
                    <span><b>{b.uitgever}</b>, {b.titel}{b.datum && `, ${b.datum}`}. <span class="fz-eigen-zacht">{b.weg ? t('eigen_bron_weg') : b.geen_kopie || t('eigen_archief_volgt')}</span></span>
                  )}
                  {b.url && b.archief && <> · <a href={b.archief}>{t('eigen_archief')}</a></>} <span class="fz-eigen-zacht">({b.soort_tekst})</span>
                </span>
              </li>
            ))}
          </ol>
        </section>

        {verbanden && (
          <section id="verbanden" class="mt-10">
            <div class="sectiekop"><h2 class="leeskop">{t('verbanden_kop')}</h2></div>
            <div class="grid gap-4">
              {(p?.dossiers ?? []).map((d) => (
                <a class="kaart flex items-center gap-4 p-3" href={pad(taal, 'dossiers', d.sleutel)}>
                  <span class={`kaartveld veld-groen veld-kaart-dossier-${d.sleutel} block size-16 flex-none rounded-[8px]`} aria-hidden="true"></span>
                  <span><span class="mono">{t('dossier_deel_van')}</span><span class="block font-semibold">{d.naam}</span></span>
                </a>
              ))}
              {naamRijen.length > 0 && (
                <div class="verband-groep grid gap-2.5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="font-medium">{t('meer_met', { naam: eersteNaam.naam })}</p><a class="link text-[13px]" href={`${pad(taal, 'fact-checks')}?naam=${eersteNaam.nummer}`}>{t('bekijk_alle', { n: metNaam.aantal })}</a></div>
                  <ol class="rijen">{naamRijen.map((r) => <Rij r={r} />)}</ol>
                </div>
              )}
              {p?.thema && themaRijen.length > 0 && (
                <div class="verband-groep grid gap-2.5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"><p class="flex items-center gap-2 font-medium"><ThemaTegel thema={p.thema.sleutel} maat="midden" />{t('meer_in', { thema: p.thema.naam })}</p><a class="link text-[13px]" href={`${pad(taal, 'fact-checks')}?thema=${p.thema.sleutel}`}>{t('bekijk_alle', { n: inThema.aantal })}</a></div>
                  <ol class="rijen">{themaRijen.map((r) => <Rij r={r} />)}</ol>
                </div>
              )}
              {p?.namen?.length > 0 && <p class="flex flex-wrap items-center gap-1.5"><span class="mono me-1">{t('nav_namen')}</span>{p.namen.map((n) => <a class="knop" href={pad(taal, 'names', n.nummer)}>{n.naam}</a>)}</p>}
            </div>
          </section>
        )}

        <section id="herkomst" class="mt-10 border-t border-[var(--lijn)] pt-4">
          {p?.melden && (
            <div class="mb-4 grid gap-1" data-melden>
              <p class="text-[14px]"><span class="font-medium">{p.melden.vraag}</span> <a class="link" href={p.melden.href}>{p.melden.tekst}</a>
                <span class="mono ms-1 select-all">{p.melden.adres}</span></p>
            </div>
          )}
          <div class="fz-eigen-voet">
            <span>{t('eigen_geschreven', { naam: e.auteur })}</span>
            {/* de redactie in de taal van de site, ook bij een vertaalde check; een andere nalezer bij naam */}
            <span>{e.nalezer === REDACTIE ? t(e.nagelezen_in ? `eigen_nagelezen_redactie_${e.nagelezen_in}` : 'eigen_nagelezen_redactie') : t('eigen_nagelezen', { naam: e.nalezer || t('eigen_nog_niemand') })}</span>
            {e.gepubliceerd && <span>{t('eigen_gepubliceerd', { datum: e.gepubliceerd })}</span>}
          </div>
        </section>
        {e.nog_doen.length > 0 && (
          <aside class="fz-eigen-nogdoen"><h3>{t('eigen_nog_doen')}</h3><ol>{e.nog_doen.map((n) => <li><Stukken s={n} taal={taal} /></li>)}</ol></aside>
        )}
      </article>

      {/* naast het artikel, zoals bij een factcheck: de contextkaarten van haar pagina in het archief, dan de inhoud, die
          blijft staan; op een telefoon alleen de kaarten, onder het artikel */}
      <aside class="grid content-start gap-6">
        {p?.context?.length > 0 && <ContextKaarten kaarten={p.context} />}
        <nav class="inhoud max-lg:hidden lg:sticky lg:top-20" aria-label={t('op_deze_pagina')}>
          <p class="mb-2 text-[12px] font-semibold text-[var(--zacht)]">{t('op_deze_pagina')}</p>
          {inhoud.map(([id, naam]) => <a href={`#${id}`}>{naam}</a>)}
        </nav>
      </aside>
    </div>
  </div>
  <script>
    // Terug naar de lijst (#828): kwam je uit de lijst van eigen checks, dan terug op dezelfde plek.
    const terug = document.getElementById('terug');
    const van = document.referrer ? new URL(document.referrer) : null;
    if (terug && van && van.origin === location.origin && van.pathname === terug.dataset.lijst) {
      terug.addEventListener('click', (e) => { e.preventDefault(); history.back(); });
    }
  </script>
</Site>
