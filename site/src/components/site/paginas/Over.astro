---
// De site, Over Factiz (PLAN #34.2t): wat we doen en niet doen, hoe je een fout meldt en wat de site van een bezoeker
// ziet. De tekst staat in de woordenlijsten van het platform, in vijf talen; het adres staat er als tekst, zoals op het
// platform. De ankers #corrections en #privacy blijven, want andere pagina's wijzen ernaar.
import Site from '../../../layouts/Site.astro';
import Kruimel from '../Kruimel.astro';
import { maakT } from '../../../lib/teksten.js';
import { TALEN, pad } from '../../../lib/talen.js';
import { CONTACT } from '../../../lib/platform.js';
import { meetId } from '../../../lib/meetid.js';
const { taal } = Astro.props;
const t = maakT(taal);
// meten na een ja (B88): de privacypagina zegt wat er gemeten wordt, alleen als er gemeten kan worden
const ga = meetId();
---
<Site titel={t('nav_over')} omschrijving={t('over_inleiding')} taal={taal} delen={['about']} aangeboden={TALEN}>
  <div class="baan pt-4">
    <Kruimel taal={taal} stappen={[[t('nav_over')]]} />
    <header class="paginakop">
      <h1 class="groot-kop">{t('nav_over')}</h1>
      <p class="leestekst">{t('over_inleiding')}</p>
    </header>
    <article class="mt-10 grid max-w-[65ch] gap-10">
      <section id="wat" aria-labelledby="k-wat" class="grid gap-3">
        <h2 id="k-wat" class="leeskop">{t('over_wat_kop')}</h2>
        <p class="leestekst">{t('over_wat_p1')}</p>
        <p class="leestekst">{t('over_wat_p2')}</p>
      </section>
      <section id="corrections" aria-labelledby="k-fout" class="grid gap-3">
        <h2 id="k-fout" class="leeskop">{t('over_fout_kop')}</h2>
        <p class="leestekst">{t('over_fout_p1')}</p>
        <p class="leestekst">{t('over_fout_adres')} <span class="mono text-[14px] text-[var(--inkt)] select-all">{CONTACT}</span></p>
      </section>
      <section id="privacy" aria-labelledby="k-privacy" class="grid gap-3">
        <h2 id="k-privacy" class="leeskop">{t('over_privacy_kop')}</h2>
        <p class="leestekst">{t(ga ? 'over_privacy_p1_meten' : 'over_privacy_p1')}</p>
        {ga && <p class="leestekst">{t('over_privacy_meten')}</p>}
        <p class="leestekst">{t('over_privacy_tellen')}</p>
        <p class="leestekst">{t('over_privacy_weergave')}</p>
        <p class="leestekst">{t('over_privacy_herkomst')}</p>
      </section>
    </article>
  </div>
</Site>
