---
// De site, een thema of onderdeel (PLAN #34.2u, DESIGN §4w): bovenaan het veld van het thema met de naam erop, zoals
// elke pagina sinds #33.6d (nooit een veld achter een bewering, oordeel of bron, D11); dan de onderdelen, de dossiers die
// erbij horen (dezelfde kaart als op de start), en de lijst met zoeken en filters met het thema vast (PLAN #34.2bb).
import Site from '../../../layouts/Site.astro';
import Kruimel from '../Kruimel.astro';
import Bibliotheek from '../Bibliotheek.jsx';
import DossierKaart from '../DossierKaart.astro';
import Plaat from '../Plaat.jsx';
import { maakT } from '../../../lib/teksten.js';
import { bibliotheektekst } from '../../../lib/tekstset.js';
import { TALEN, pad } from '../../../lib/talen.js';
const { taal, g, lijst, paren } = Astro.props;
const t = maakT(taal);
const delen = ['themes', g.sleutel, ...(g.deel ? [g.deel.sleutel] : [])];
// het thema (en het onderdeel) vast; de filters van de bezoeker in het adres, en dan niet vindbaar (E9.S27 AC3, AC4)
const vast = [['thema', g.sleutel], ...(g.deel ? [['onderdeel', g.deel.sleutel]] : [])];
const aangeboden = paren.length ? [] : TALEN;
// zonder script zoekt het formulier in de lijst, met het thema als filter (AC5)
const actie = `${pad(taal, 'fact-checks')}?${new URLSearchParams(vast)}`;
---
<Site titel={g.kop} omschrijving={g.omschrijving} taal={taal} delen={delen} aangeboden={aangeboden} beeld={g.deelbeeld?.src} beeldAlt={g.deelbeeld?.alt}>
  <div class="baan pt-4">
    <Kruimel taal={taal} stappen={[[g.kicker, pad(taal, 'themes')], g.deel && [g.thema_naam, g.thema_href]]} />
    <header class={`kaartveld veld-groen veld-band-thema-${g.sleutel} mt-4 px-6 pt-24 pb-6 sm:px-10 sm:pt-32 sm:pb-8`}>
      <Plaat sleutel={g.sleutel} plek="band" />
      <span class="inline-flex h-6 items-center rounded-full bg-white/15 px-2.5 text-[12px] font-medium text-white backdrop-blur">{g.deel ? g.thema_naam : g.kicker}</span>
      <h1 class="groot-kop mt-3 max-w-[22ch] text-white">{g.kop}</h1>
    </header>
    {g.onderdelen.length > 0 && (
      <nav class="mt-8" aria-label={g.onderdelen_kop}>
        <p class="text-[12px] font-semibold text-[var(--zacht)]">{g.onderdelen_kop}</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {g.onderdelen.map((o) => <li><a class="knop" href={o.href}>{o.naam} <span class="mono">{o.aantal}</span></a></li>)}
        </ul>
      </nav>
    )}
    {g.dossiers.length > 0 && (
      <section class="mt-10" aria-labelledby="dossiers">
        <div class="sectiekop"><h2 id="dossiers">{t('nav_dossiers')}</h2></div>
        <ul class="grid grid-cols-1 gap-3 md:grid-cols-2">{g.dossiers.map((d) => <li><DossierKaart d={d} href={pad(taal, 'dossiers', d.sleutel)} taal={taal} /></li>)}</ul>
      </section>
    )}
    <section class="mt-6" aria-label={t('thema_lijst', { naam: g.kop })}>
      <Bibliotheek client:load begin={lijst} tekst={bibliotheektekst(taal)} beginVraag="" beginParen={paren} actie={actie}
                   taal={taal} vast={vast} basis={pad(taal, ...delen)} kop={t('thema_lijst', { naam: g.kop })} />
    </section>
  </div>
</Site>
