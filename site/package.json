{
  "name": "factiz-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "De site van Factiz (B76, PLAN #34.2f): Astro op de server met React, Tailwind en Radix; de gegevens van het platform zelf.",
  "scripts": {
    "dev": "astro dev --port 8796",
    "build": "astro build",
    "start": "HOST=127.0.0.1 PORT=8796 node dist/server/entry.mjs",
    "build:worker": "FACTIZ_DOEL=worker astro build && node scripts/worker-voorraad.mjs",
    "worker:lokaal": "wrangler dev --config dist-worker/server/wrangler.json --port 8795 --persist-to .wrangler/lokaal",
    "build:placeholder": "astro build --config astro.placeholder.config.mjs",
    "dev:placeholder": "astro dev --config astro.placeholder.config.mjs --port 8798",
    "platen": "node scripts/platen.mjs",
    "lettertypen": "node scripts/lettertypen.mjs"
  },
