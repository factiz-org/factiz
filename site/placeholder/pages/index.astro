---
// De placeholder van factiz.org (PLAN #34.2f, stap 3b): één stille pagina uit de site, statisch gebouwd, die ook dient
// als onderhoudspagina. Geen script, niets van elders, de tekst uit de woordenlijsten in de vijf talen van de site.
// Bouwen: `npm --prefix site run build:placeholder`, uitvoer in `site/dist-placeholder/`, zo te uploaden naar Cloudflare
// Pages; een adres dat er niet is, krijgt daar deze pagina.
import '@fontsource-variable/geist/index.css';
import woordmerk from '../../../factiz_site/static/merk/woordmerk-inline.svg?raw';
import corpus from '../../../factiz_site/static/beeld/corpus.webp';
import favicon from '../../../factiz_site/static/merk/favicon.ico?url';
import logo from '../../../factiz_site/static/merk/logo.svg?url';
import { maakT } from '../../src/lib/teksten.js';
import { TALEN, EIGEN_NAAM, BASIS_TALEN } from '../../src/lib/talen.js';

const ADRES = 'info@factiz.org';
const t = maakT('en');
const anderen = TALEN.filter((c) => c !== 'en' && BASIS_TALEN.includes(c)).map((c) => ({ code: c, naam: EIGEN_NAAM[c], t: maakT(c) }));
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Factiz</title>
<meta name="description" content={t('wacht_tekst')}>
<meta name="robots" content="noindex">
<meta name="color-scheme" content="dark">
<link rel="icon" href={favicon} sizes="48x48"><link rel="icon" type="image/svg+xml" href={logo}>
</head>
<body>
<main>
  <img class="veld" src={corpus.src} width={corpus.width} height={corpus.height} alt="">
  <div class="binnen">
    <div class="merk"><Fragment set:html={woordmerk} /></div>
    <h1>{t('wacht_kop')}</h1>
    <p class="tekst">{t('wacht_tekst')}</p>
    <ul class="talen">
      {anderen.map((a) => <li lang={a.code}><b>{a.t('wacht_kop')}</b> {a.t('wacht_tekst')}</li>)}
    </ul>
    <p class="adres"><a href={`mailto:${ADRES}`}>{ADRES}</a></p>
  </div>
</main>
</body>
</html>
<style is:global>
  :root { color-scheme: dark; }
  html, body { margin: 0; min-height: 100%; background: #0d0e10; color: #fff; }
  body { font-family: "Geist Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 15px;
         line-height: 1.55; -webkit-font-smoothing: antialiased; }
  main { position: relative; isolation: isolate; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  .veld { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 85%; }
  main::before { content: ""; position: absolute; inset: 0; z-index: -1;
                 background: linear-gradient(180deg, rgb(10 10 10 / .5), rgb(10 10 10 / .15) 40%, rgb(10 10 10 / .78)); }
  .binnen { box-sizing: border-box; width: 100%; max-width: 46rem;
            padding: max(2rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right)) max(2.5rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left)); }
  @media (min-width: 48rem) { .binnen { padding: 4rem 4.5rem; } }
  .merk svg { display: block; height: 1.6rem; width: auto; }
  h1 { margin: 1rem 0 .5rem; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -.035em; font-weight: 600; text-wrap: balance; }
  .tekst { margin: 0; max-width: 38rem; font-size: 1.05rem; color: rgb(255 255 255 / .9); }
  .talen { list-style: none; margin: 1.75rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid rgb(255 255 255 / .2);
           display: grid; gap: .6rem; font-size: .875rem; color: rgb(255 255 255 / .78); }
  .talen b { color: #fff; font-weight: 500; }
  .adres { margin: 1.5rem 0 0; }
  .adres a { display: inline-flex; align-items: center; min-height: 44px; color: #fff; text-underline-offset: .2em; }
  .adres a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; border-radius: 3px; }
</style>
